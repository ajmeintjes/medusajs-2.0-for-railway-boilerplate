# Spot Price API Configuration
# Add these variables to your main .env file

# Primary API Configuration (required)
METALS_API_PRIMARY_KEY=your_primary_api_key_here
METALS_API_PRIMARY_URL=https://api.metals-api.com/v1

# Backup API Configuration (optional but recommended)
METALS_API_BACKUP_KEY=your_backup_api_key_here
METALS_API_BACKUP_URL=https://backup-api.example.com

# API Settings
METALS_API_TIMEOUT=10000
METALS_API_MAX_RETRIES=3

# Alternative APIs you can use:
# 
# Metals-API.com (Primary recommendation)
# - Sign up at: https://metals-api.com/
# - Free tier: 1000 requests/month
# - Example URL: https://api.metals-api.com/v1
# 
# Alpha Vantage (Alternative)
# - Sign up at: https://www.alphavantage.co/
# - Free tier: 25 requests/day
# - Example URL: https://www.alphavantage.co/query
# 
# Fixer.io (Currency focused but has metals)
# - Sign up at: https://fixer.io/
# - Free tier: 1000 requests/month
# - Example URL: https://api.fixer.io/v1

# Usage Notes:
# - The spot price import widget will use these environment variables by default
# - If not set, you can configure API keys manually in the widget interface
# - Primary API is required, backup API is optional for redundancy
# - Different APIs may require different formats - check your provider's documentation
